# Copy to .env and edit. All values can also be set as environment variables
# with the MCV_ prefix (e.g. MCV_BACKBONE=hash).

# --- Paths ---------------------------------------------------------------
MCV_DATA_DIR=./data
MCV_CATALOG_DB=./data/catalog/catalog.sqlite
MCV_INDEX_DIR=./data/index
MCV_MODEL_DIR=./data/models

# --- Embedding backbone --------------------------------------------------
# hash        : dependency-free numpy embedder (dev / CI only, low accuracy)
# tinycnn     : compact CNN trained from scratch with `mcv train -c configs/train_tinycnn.yaml`
# openclip    : open_clip (e.g. ViT-B-16 / SigLIP) - requires `pip install .[ml]`
# dinov2      : timm DINOv2 - requires `pip install .[ml]`
# ensemble    : weighted concatenation of MCV_ENSEMBLE_MEMBERS
MCV_BACKBONE=hash
MCV_ENSEMBLE_MEMBERS=tinycnn,hash
MCV_ENSEMBLE_WEIGHTS=1.0,0.3
MCV_BACKBONE_MODEL=ViT-B-16
MCV_BACKBONE_PRETRAINED=laion2b_s34b_b88k   # 'none' = random init (offline smoke tests)
MCV_BACKBONE_CHECKPOINT=            # fine-tuned weights produced by `mcv train`
MCV_DEVICE=auto

# --- Vector index --------------------------------------------------------
# numpy : exact brute force (fine to ~100k vectors)
# faiss : IVF-PQ / HNSW, scales to millions - requires `pip install .[faiss]`
MCV_INDEX_BACKEND=numpy
MCV_INDEX_TOP_K=50
MCV_INDEX_GALLERY_AUGMENT=2       # extra photo-style rows per catalog image (database-side augmentation)
MCV_QUERY_EXPANSION_K=0           # alpha query expansion neighbours; try 3 with learned backbones

# --- Reranking -----------------------------------------------------------
MCV_RERANK_LLM_ENABLED=false
MCV_RERANK_LLM_MODEL=claude-opus-5
MCV_RERANK_LLM_CANDIDATES=8
ANTHROPIC_API_KEY=

# --- OCR -----------------------------------------------------------------
MCV_OCR_ENABLED=false

# --- API -----------------------------------------------------------------
MCV_API_HOST=0.0.0.0
MCV_API_PORT=8000
MCV_MAX_UPLOAD_MB=20
